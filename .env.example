# 이 파일을 .env로 복사하거나 운영체제 환경변수로 설정할 수 있습니다.
# 실제 키가 들어간 .env는 Git에 올라가지 않습니다.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_MIN_REQUEST_INTERVAL_SECONDS=12.5
# 대표 이미지는 항상 로컬에서 생성하므로 이미지 모델은 사용하지 않습니다.
GEMINI_IMAGE_MODEL=
# 긴 프롬프트는 직접 값 또는 UTF-8 텍스트 파일 경로 중 하나로 지정할 수 있습니다.
BLOG_WRITING_PROMPT=
BLOG_WRITING_PROMPT_FILE=
IMAGE_GENERATION_PROMPT=
IMAGE_GENERATION_PROMPT_FILE=
KAKAO_REST_API_KEY=
KAKAO_JAVASCRIPT_KEY=
DATA_GO_KR_SERVICE_KEY=
